{
  "name": "tarteeb-scheduler",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:server\" \"vite --host 0.0.0.0\"",
    "start": "node scripts/start.cjs",
    "start:vite": "npm run dev",
    "start:react-scripts": "node scripts/start.cjs --react-scripts",
    "server": "node --watch server/index.js",
    "build": "vite build",
    "build:react-scripts": "node scripts/build-cra.cjs",
    "test": "node --test tests/*.test.js",
    "sample": "node scripts/create-sample.js",
    "format": "prettier --write src server scripts tests vite.config.js"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hot-toast": "2.6.1",
    "react-icons": "5.7.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.5",
    "prettier": "3.9.9",
    "vite": "8.3.2",
    "ajv": "^8.17.1"
  },
  "optionalDependencies": {
    "react-scripts": "5.0.1"
  },
  "engines": {
    "node": ">=24"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "http://127.0.0.1:3001",
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
